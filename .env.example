# Both of these are optional — the app works fine without them, asking you
# to enter your account and (optionally) an API key in the Settings page
# instead, saved to your browser's localStorage.
#
# Set these only if you want a deployed build (e.g. GitHub Pages) to load
# straight to your own stats with zero setup on every device. Copy this file
# to `.env` and fill in — `.env` is gitignored, so it stays out of the repo.

# Your account_id (32-bit) or SteamID64 - see README for how to find it.
VITE_DEFAULT_ACCOUNT_ID=

# Optional OpenDota API key for a higher rate limit than the free tier.
VITE_OPENDOTA_API_KEY=
