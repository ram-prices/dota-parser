# Both of these are optional for local dev — without them the app asks you
# to enter your account and (optionally) an API key in the Settings page,
# saved to your browser's localStorage. Copy this file to `.env` and fill
# in to skip that step locally too — `.env` is gitignored, so it stays out
# of the repo. (The deployed GitHub Pages build already has the account_id
# below baked in via .github/workflows/deploy.yml.)

# Your account_id (32-bit) or SteamID64 - see README for how to find it.
VITE_DEFAULT_ACCOUNT_ID=90031862

# Optional OpenDota API key for a higher rate limit than the free tier.
VITE_OPENDOTA_API_KEY=
