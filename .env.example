# ---- Steam Web API ----
# Get a free key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Comma-separated list of the accounts to auto-track.
# Accepts either SteamID64 (e.g. 76561198012345678) or 32-bit account_id (e.g. 51780950).
# Find your SteamID64 at https://steamid.io/ (paste your profile URL).
STEAM_ACCOUNT_IDS=

# How often (seconds) the poller checks Steam for new matches.
# Valve replays are only kept on their CDN for a limited time, so don't set this too high.
POLL_INTERVAL_SECONDS=300

# ---- Postgres ----
POSTGRES_USER=dota
POSTGRES_PASSWORD=dota
POSTGRES_DB=dota_parser
DATABASE_URL=postgres://dota:dota@postgres:5432/dota_parser

# ---- Internal service URLs (defaults match docker-compose, no need to change) ----
PARSER_URL=http://parser:5600
PORT=8080

# ---- Frontend ----
VITE_API_BASE=/api
